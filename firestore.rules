rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /registrationRequests/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll([
          'shopName',
          'ownerName',
          'email',
          'status',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'shopName',
          'ownerName',
          'email',
          'phone',
          'status',
          'createdAt'
        ])
        && request.resource.data.shopName is string
        && request.resource.data.shopName.size() >= 2
        && request.resource.data.shopName.size() <= 120
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() >= 2
        && request.resource.data.ownerName.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (
          !('phone' in request.resource.data)
          || (
            request.resource.data.phone is string
            && request.resource.data.phone.size() <= 32
          )
        );
      allow update, delete: if false;
    }

    match /deviceBindings/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasAll(['deviceId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['deviceId', 'createdAt'])
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() >= 20
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
