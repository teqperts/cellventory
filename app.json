{
  "expo": {
    "name": "Cellventory",
    "slug": "cellventory",
    "owner": "teqperts",
    "version": "1.0.0",
    "scheme": "com.teqperts.cellventory",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#141821"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.teqperts.cellventory",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141821"
      },
      "navigationBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#FFFFFF"
      }
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cellventory to scan device IMEI barcodes when accepting repairs."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#141821",
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 200,
            "backgroundColor": "#141821"
          }
        }
      ],
      "expo-web-browser",
      "react-native-nitro-google-signin"
    ],
    "updates": {
      "url": "https://u.expo.dev/95fbfe1f-89c3-4dc2-8028-7e472bf12092",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "95fbfe1f-89c3-4dc2-8028-7e472bf12092"
      }
    }
  }
}
