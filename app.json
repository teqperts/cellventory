{
  "expo": {
    "name": "Cellventory",
    "slug": "cellventory",
    "owner": "teqperts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.teqperts.cellventory",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "navigationBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#FFFFFF"
      }
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Cellventory to scan device IMEI barcodes when accepting repairs."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "95fbfe1f-89c3-4dc2-8028-7e472bf12092"
      }
    }
  }
}
